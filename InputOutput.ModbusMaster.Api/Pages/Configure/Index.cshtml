@page
@model InputOutput.ModbusMaster.Api.Pages.Configure.IndexModel
@{
    ViewData["Title"] = "Configure";
}

<div class="mb-4">
    <h1 class="mb-1">Configure</h1>
    <div class="text-muted">Serial line settings, scan range, and registered devices.</div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5 class="card-title">Connection</h5>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <form method="post" asp-page-handler="Connect">
                <button class="btn btn-primary" type="submit">@(Model.IsConnected ? "Reconnect" : "Connect")</button>
            </form>
            <form method="post" asp-page-handler="Disconnect">
                <button class="btn btn-outline-secondary" type="submit" @(Model.IsConnected ? null : "disabled")>Disconnect</button>
            </form>
            <form method="post" asp-page-handler="StartPolling">
                <button class="btn btn-outline-secondary" type="submit" @(Model.IsConnected && !Model.IsPolling ? null : "disabled")>Start polling</button>
            </form>
            <form method="post" asp-page-handler="StopPolling">
                <button class="btn btn-outline-secondary" type="submit" @(Model.IsPolling ? null : "disabled")>Stop polling</button>
            </form>
        </div>
        <div>
            <span class="badge @(Model.IsConnected ? "text-bg-success" : "text-bg-secondary")">@(Model.IsConnected ? "connected" : "offline")</span>
            @if (Model.IsPolling)
            {
                <span class="badge text-bg-success">polling</span>
            }
        </div>
    </div>
</div>

<form method="post">
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="card-title">Serial &amp; polling</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.PortName">Port</label>
                    <select class="form-select" asp-for="Input.PortName" asp-items="Model.PortOptions"></select>
                    @if (Model.PortOptions.Count == 0)
                    {
                        <div class="form-text text-warning">No serial ports detected on this PC.</div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.BaudRate">Baud</label>
                    <select class="form-select" asp-for="Input.BaudRate" asp-items="Model.BaudRateOptions"></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.Parity">Parity</label>
                    <select class="form-select" asp-for="Input.Parity" asp-items="Model.ParityOptions"></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.StopBits">Stop bits</label>
                    <select class="form-select" asp-for="Input.StopBits" asp-items="Model.StopBitsOptions"></select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.PollIntervalMs">Poll interval (ms)</label>
                    <input class="form-control" asp-for="Input.PollIntervalMs" type="number" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.InterDeviceDelayMs">Inter-device delay (ms)</label>
                    <input class="form-control" asp-for="Input.InterDeviceDelayMs" type="number" />
                </div>
                <div class="col-12 d-flex flex-wrap gap-4">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.AutoConnect" />
                        <label class="form-check-label" asp-for="Input.AutoConnect">Auto-connect on startup</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.AutoScan" />
                        <label class="form-check-label" asp-for="Input.AutoScan">Auto-scan on startup</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="card-title">Scan defaults</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="Input.ScanUnitIdFrom">Unit ID from</label>
                    <input class="form-control" asp-for="Input.ScanUnitIdFrom" type="number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Input.ScanUnitIdTo">Unit ID to</label>
                    <input class="form-control" asp-for="Input.ScanUnitIdTo" type="number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Input.ScanInterProbeDelayMs">Probe delay (ms)</label>
                    <input class="form-control" asp-for="Input.ScanInterProbeDelayMs" type="number" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RegisterDiscoveredDevices" />
                        <label class="form-check-label" asp-for="Input.RegisterDiscoveredDevices">Register discovered devices</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="card-title">Devices</h5>
            @if (Model.Input.Devices.Count == 0)
            {
                <div class="alert alert-secondary mb-3">No configured devices.</div>
            }

            @for (var i = 0; i < Model.Input.Devices.Count; i++)
            {
                <div class="device-editor">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Input.Devices[i].Type">Type</label>
                            <select class="form-select" asp-for="Input.Devices[i].Type" asp-items="Model.DeviceTypeOptions"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Input.Devices[i].UnitId">Unit ID</label>
                            <input class="form-control" asp-for="Input.Devices[i].UnitId" type="number" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Input.Devices[i].Name">Name</label>
                            <input class="form-control" asp-for="Input.Devices[i].Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Input.Devices[i].Identifier">Identifier</label>
                            <input class="form-control" asp-for="Input.Devices[i].Identifier" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Input.Devices[i].SerialNumber">Serial</label>
                            <input class="form-control" asp-for="Input.Devices[i].SerialNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Input.Devices[i].Mode">Waveshare mode</label>
                            <select class="form-select" asp-for="Input.Devices[i].Mode" asp-items="Model.ModeOptions"></select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-sm btn-outline-danger" type="submit" formaction="?handler=RemoveDevice&amp;index=@i" formmethod="post">Remove</button>
                    </div>
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-outline-secondary" type="submit" formaction="?handler=AddDevice" formmethod="post">Add device</button>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-2">
        <button class="btn btn-primary" type="submit" asp-page-handler="Save">Save to appsettings</button>
        <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Apply">Apply live only</button>
    </div>
    <div class="small text-muted">Save writes the ModbusRtu section to appsettings.json. Serial changes take effect on the next Connect.</div>
</form>
