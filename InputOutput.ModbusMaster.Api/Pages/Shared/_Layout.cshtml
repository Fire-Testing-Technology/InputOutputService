@using InputOutput.ModbusMaster
@inject IModbusMaster Master
@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool NavActive(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Input Output</title>
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('inputoutput-theme');
                if (theme !== 'light' && theme !== 'dark') theme = 'dark';
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/app.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="page">
        <div class="sidebar">
            <nav class="nav flex-column p-3">
                <div class="sidebar-brand mb-3">
                    <a asp-page="/Index" class="ftt-logo-link" aria-label="Fire Testing Technology home">
                        <img src="~/images/ftt_full_logo.png" alt="Fire Testing Technology" class="ftt-logo ftt-logo--sidebar" />
                    </a>
                </div>
                <a class="nav-link @(NavActive("/Devices") ? "active" : null)" asp-page="/Devices/Index">Devices</a>
                <a class="nav-link @(NavActive("/Scan") ? "active" : null)" asp-page="/Scan/Index">Scan</a>
                <a class="nav-link @(NavActive("/Configure") ? "active" : null)" asp-page="/Configure/Index">Configure</a>
                <a class="nav-link" href="/swagger" target="_blank" rel="noopener">API (Swagger)</a>
            </nav>
        </div>

        <main>
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <div class="header-brand d-flex align-items-center gap-3">
                    <a asp-page="/Index" class="ftt-logo-link" aria-label="Fire Testing Technology home">
                        <img src="~/images/ftt_full_logo.png" alt="Fire Testing Technology" class="ftt-logo ftt-logo--header" />
                    </a>
                    <span class="header-title text-muted">Input / Output</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="status-pill @(Master.IsConnected ? "online" : "offline")"
                         title="@(Master.IsConnected ? "RTU connected" : "RTU disconnected")">
                        <span class="dot"></span>
                        @(Master.IsConnected ? "Connected" : "Offline")
                        @if (Master.IsPolling)
                        {
                            <span class="poll">polling</span>
                        }
                    </div>
                    <div class="theme-toggle" role="group" aria-label="Colour theme">
                        <button type="button" class="theme-toggle-btn" data-theme="light" title="Light theme">Light</button>
                        <button type="button" class="theme-toggle-btn" data-theme="dark" title="Dark theme">Dark</button>
                    </div>
                </div>
            </div>

            <article class="content px-4 py-3">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-secondary">@message</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }
                @RenderBody()
            </article>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script>
        (function () {
            function measure(className) {
                var el = document.createElement('button');
                el.type = 'button';
                el.className = className;
                el.textContent = 'Start polling';
                el.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;pointer-events:none;white-space:nowrap;';
                document.body.appendChild(el);
                var width = el.getBoundingClientRect().width;
                el.remove();
                return width;
            }

            var normal = measure('btn btn-primary');
            var small = measure('btn btn-sm btn-primary');
            document.documentElement.style.setProperty('--btn-min-width', (normal * 1.5) + 'px');
            document.documentElement.style.setProperty('--btn-min-width-sm', (small * 1.5) + 'px');
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
